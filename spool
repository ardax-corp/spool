#!/usr/bin/env bash
# spool — Coil library dependency manager (bash driver + Coil plan/link).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
COIL_BIN="${COIL:-coil}"

# Hooks default off. --enable-scripts opts in. --ignore-scripts always wins (CI).
# allow_exec is not the gate. Every user-script sh goes through may_run_hook.
FORCE_OFF=0
WANT_ON=0
WITH_NATIVES=0
ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--ignore-scripts" ]]; then
    FORCE_OFF=1
  elif [[ "$arg" == "--enable-scripts" ]]; then
    WANT_ON=1
  elif [[ "$arg" == "--with-natives" ]]; then
    WITH_NATIVES=1
  else
    ARGS+=("$arg")
  fi
done
if [[ "$FORCE_OFF" -eq 1 ]]; then
  IGNORE_SCRIPTS=1
elif [[ "$WANT_ON" -eq 1 ]]; then
  IGNORE_SCRIPTS=0
else
  IGNORE_SCRIPTS="${SPOOL_IGNORE_SCRIPTS:-1}"
fi
if [[ ${#ARGS[@]} -gt 0 ]]; then
  set -- "${ARGS[@]}"
else
  set --
fi
export SPOOL_IGNORE_SCRIPTS="$IGNORE_SCRIPTS"

CMD="${1:-help}"
shift || true

export SPOOL_PROJECT="${SPOOL_PROJECT:-$(pwd)}"
# Fail closed on missing credentials instead of hanging on a TTY prompt.
export GIT_TERMINAL_PROMPT="${GIT_TERMINAL_PROMPT:-0}"

GIT_AUTH_HINT="Private remotes use ssh-agent, GIT_ASKPASS, git credential helpers, or url.insteadOf in ~/.gitconfig. spool does not store credentials. GIT_TERMINAL_PROMPT=0 so a missing credential fails instead of hanging."

run_coil() {
  local sub="$1"
  export SPOOL_CMD="$sub"
  "$COIL_BIN" "$ROOT/spool.hy"
}

check_status() {
  local st="$SPOOL_PROJECT/.spool/status"
  if [[ ! -f "$st" ]]; then
    echo "spool: missing status file" >&2
    exit 1
  fi
  local msg
  msg="$(cat "$st")"
  if [[ "$msg" != "ok" ]]; then
    echo "spool: $msg" >&2
    exit 1
  fi
}

# Fail closed on [package].coil before fetch when the manifest is local/cached;
# caller also runs this after checkout for newly fetched packages.
check_engine() {
  local out=""
  out="$("$COIL_BIN" --version 2>/dev/null || true)"
  export SPOOL_COIL_VERSION_OUTPUT="$out"
  run_coil check_engine
  check_status
}

git_failed() {
  local url="${1:-}"
  if [[ -n "$url" ]]; then
    echo "spool: git failed for $url" >&2
  else
    echo "spool: git failed" >&2
  fi
  echo "$GIT_AUTH_HINT" >&2
  exit 1
}

run_git_script() {
  local f="$1"
  if ! sh "$f"; then
    git_failed
  fi
}

ls_remote_tags() {
  local url="$1"
  local out="$2"
  if ! git ls-remote --tags "$url" > "$out"; then
    git_failed "$url"
  fi
}

verify_checkouts() {
  local f="$SPOOL_PROJECT/.spool/verify.tsv"
  if [[ ! -f "$f" ]]; then
    return 0
  fi
  while IFS=$'\t' read -r name dest hash; do
    [[ -z "${name:-}" ]] && continue
    if [[ ! -d "$dest" ]]; then
      echo "spool: missing package $name (expected checkout $dest)" >&2
      exit 1
    fi
    local actual
    actual="$(git -C "$dest" rev-parse 'HEAD^{tree}')"
    if [[ "$actual" != "$hash" ]]; then
      echo "spool: integrity mismatch for $name: expected $hash, got $actual" >&2
      exit 1
    fi
  done < "$f"
}

# Fetch direct natives into ~/.coil/natives (or $COIL_NATIVES_DIR).
# Usage: download_natives [packaged-exe]
# With no arg, uses project [[ffi.native]] via `coil natives dump --tsv`.
download_natives() {
  local exe="${1:-}"
  local natives_root="${COIL_NATIVES_DIR:-${HOME}/.coil/natives}"
  local host_os host_arch
  host_os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
    x86_64|amd64) host_arch="x86_64" ;;
    aarch64|arm64) host_arch="aarch64" ;;
    *) host_arch="$(uname -m)" ;;
  esac
  # Normalize Darwin → macos to match Rust std::env::consts::OS.
  if [[ "$host_os" == "darwin" ]]; then
    host_os="macos"
  fi

  local tsv
  if [[ -n "$exe" ]]; then
    if ! tsv="$("$COIL_BIN" natives dump --tsv "$exe")"; then
      echo "spool download: coil natives dump failed for $exe" >&2
      exit 1
    fi
  else
    if ! tsv="$(cd "$SPOOL_PROJECT" && "$COIL_BIN" natives dump --tsv)"; then
      echo "spool download: coil natives dump failed (project mode)" >&2
      exit 1
    fi
  fi

  local lock_os="" lock_arch=""
  local line package version filename url sha size
  local installed=0 skipped=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    if [[ "$line" == \#\ os=* ]]; then
      lock_os="${line#\# os=}"
      continue
    fi
    if [[ "$line" == \#\ arch=* ]]; then
      lock_arch="${line#\# arch=}"
      continue
    fi
    [[ "$line" == \#* ]] && continue
    IFS=$'\t' read -r package version filename url sha size <<< "$line"
    [[ -z "${package:-}" ]] && continue

    if [[ -n "$lock_os" && "$lock_os" != "$host_os" ]]; then
      echo "spool download: native lock os=$lock_os but host is $host_os" >&2
      exit 1
    fi
    if [[ -n "$lock_arch" && "$lock_arch" != "$host_arch" ]]; then
      echo "spool download: native lock arch=$lock_arch but host is $host_arch" >&2
      exit 1
    fi

    local hash16="${sha:0:16}"
    local dest_dir="$natives_root/cache/$package/$version/$hash16"
    local dest="$dest_dir/$filename"
    if [[ -f "$dest" ]]; then
      local actual
      actual="$(sha256sum "$dest" | awk '{print $1}')"
      if [[ "$actual" == "$sha" ]]; then
        echo "spool download: skip $package $version ($filename)"
        skipped=$((skipped + 1))
        continue
      fi
      echo "spool download: hash mismatch for $dest; re-fetching" >&2
      rm -f "$dest"
    fi

    mkdir -p "$dest_dir"
    local part="$dest.part"
    rm -f "$part"
    if ! curl -fsSL --proto '=https' --proto-redir '=https' -o "$part" "$url"; then
      echo "spool download: failed to fetch $url" >&2
      rm -f "$part"
      exit 1
    fi
    local got
    got="$(sha256sum "$part" | awk '{print $1}')"
    if [[ "$got" != "$sha" ]]; then
      echo "spool download: sha256 mismatch for $package: expected $sha, got $got" >&2
      rm -f "$part"
      exit 1
    fi
    if [[ -n "$size" && "$size" != "0" ]]; then
      local got_size
      got_size="$(wc -c < "$part" | tr -d ' ')"
      if [[ "$got_size" != "$size" ]]; then
        echo "spool download: size mismatch for $package: expected $size, got $got_size" >&2
        rm -f "$part"
        exit 1
      fi
    fi
    mv -f "$part" "$dest"
    echo "spool download: installed $package $version → $dest"
    installed=$((installed + 1))
  done <<< "$tsv"

  if [[ "$installed" -eq 0 && "$skipped" -eq 0 ]]; then
    echo "spool download: nothing to download"
  else
    echo "spool download: ok ($installed installed, $skipped skipped)"
  fi
}

resolve_git_dep() {
  local name="$1"
  local url="$2"
  mkdir -p "$SPOOL_PROJECT/.spool"
  ls_remote_tags "$url" "$SPOOL_PROJECT/.spool/tags.tsv"
  export SPOOL_ADD_NAME="$name"
  run_coil pick
  check_status
  run_git_script "$SPOOL_PROJECT/.spool/resolve.sh"
  run_coil apply_resolved
  check_status
}

walk_transitives() {
  local i=0
  while [[ $i -lt 32 ]]; do
    i=$((i + 1))
    run_coil collect
    check_status
    if [[ ! -s "$SPOOL_PROJECT/.spool/todo.tsv" ]]; then
      return 0
    fi
    while IFS=$'\t' read -r name url; do
      [[ -z "${name:-}" ]] && continue
      resolve_git_dep "$name" "$url"
    done < "$SPOOL_PROJECT/.spool/todo.tsv"
  done
  echo "spool: resolve loop exceeded 32 passes" >&2
  exit 1
}

materialize() {
  run_coil plan
  run_git_script "$SPOOL_PROJECT/.spool/fetch.sh"
  verify_checkouts
  check_engine
  run_coil link
}

# Current-project [scripts] only. Missing key is a no-op. Dep include-hooks are run_include_hooks.
run_project_script() {
  local slot="$1"
  case "$IGNORE_SCRIPTS" in
    0|false) ;;
    *) return 0 ;;
  esac
  export SPOOL_SCRIPT_SLOT="$slot"
  run_coil script_lookup
  check_status
  local rel
  rel="$(tr -d '\n' < "$SPOOL_PROJECT/.spool/script-rel" 2>/dev/null || true)"
  if [[ -z "$rel" ]]; then
    return 0
  fi
  local file="$SPOOL_PROJECT/$rel"
  if [[ ! -f "$file" ]]; then
    echo "spool: missing script $rel" >&2
    exit 1
  fi
  local hash
  hash="$(git hash-object "$file")"
  export SPOOL_SCRIPT_REL="$rel"
  export SPOOL_SCRIPT_HASH="$hash"
  run_coil script_gate
  check_status
  local runf
  runf="$(tr -d '\n' < "$SPOOL_PROJECT/.spool/script-run" 2>/dev/null || true)"
  if [[ "$runf" != "1" ]]; then
    return 0
  fi
  local rc=0
  set +e
  ( cd "$SPOOL_PROJECT" && sh "$rel" )
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "spool: $rel exited $rc" >&2
    exit 1
  fi
}

# Dependency [package].include after checkout+link. Does not run dep [scripts].
run_include_hooks() {
  case "$IGNORE_SCRIPTS" in
    0|false) ;;
    *) return 0 ;;
  esac
  local f="$SPOOL_PROJECT/.spool/links.tsv"
  if [[ ! -f "$f" ]]; then
    return 0
  fi
  while IFS=$'\t' read -r name dest; do
    [[ -z "${name:-}" ]] && continue
    export SPOOL_INCLUDE_NAME="$name"
    export SPOOL_INCLUDE_DEST="$dest"
    run_coil include_lookup
    check_status
    local rel
    rel="$(tr -d '\n' < "$SPOOL_PROJECT/.spool/include-rel" 2>/dev/null || true)"
    if [[ -z "$rel" ]]; then
      continue
    fi
    local file="$dest/$rel"
    if [[ ! -f "$file" ]]; then
      echo "spool: missing include-hook $name $rel" >&2
      exit 1
    fi
    local hash
    hash="$(git hash-object "$file")"
    export SPOOL_INCLUDE_REL="$rel"
    export SPOOL_INCLUDE_HASH="$hash"
    run_coil include_gate
    check_status
    local runf
    runf="$(tr -d '\n' < "$SPOOL_PROJECT/.spool/include-run" 2>/dev/null || true)"
    if [[ "$runf" != "1" ]]; then
      continue
    fi
    local rc=0
    set +e
    ( cd "$dest" && sh "$rel" )
    rc=$?
    set -e
    if [[ "$rc" -ne 0 ]]; then
      echo "spool: include-hook $name $rel exited $rc" >&2
      exit 1
    fi
  done < "$f"
}

case "$CMD" in
  help|--help|-h)
    run_coil help
    ;;
  install)
    run_coil check_install
    check_status
    check_engine
    run_project_script pre_install
    materialize
    run_include_hooks
    run_project_script post_install
    if [[ "$WITH_NATIVES" -eq 1 ]]; then
      download_natives
    fi
    echo "spool install: ok"
    ;;
  download)
    download_natives "${1:-}"
    ;;
  plan)
    run_coil plan
    ;;
  link)
    run_coil link
    ;;
  allow-include)
    NAME="${1:-}"
    if [[ -z "$NAME" ]]; then
      echo "usage: spool allow-include <name>" >&2
      exit 1
    fi
    export SPOOL_ALLOW_INCLUDE="$NAME"
    run_coil allow_include
    check_status
    echo "spool allow-include: $NAME"
    ;;
  add)
    NAME=""
    GIT=""
    PATH_DEP=""
    VERSION="*"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --git)
          GIT="${2:-}"
          shift 2
          ;;
        --path)
          PATH_DEP="${2:-}"
          shift 2
          ;;
        --version)
          VERSION="${2:-}"
          shift 2
          ;;
        --help|-h)
          run_coil help
          exit 0
          ;;
        -*)
          echo "unknown flag: $1" >&2
          exit 1
          ;;
        *)
          if [[ -z "$NAME" ]]; then
            NAME="$1"
            shift
          else
            echo "unexpected argument: $1" >&2
            exit 1
          fi
          ;;
      esac
    done
    if [[ -z "$NAME" ]]; then
      echo "usage: spool add <name> --git <url> [--version <req>]" >&2
      echo "       spool add <name> --path <path>" >&2
      exit 1
    fi
    if [[ -n "$GIT" && -n "$PATH_DEP" ]]; then
      echo "spool add: --git and --path are mutually exclusive" >&2
      exit 1
    fi
    if [[ -z "$GIT" && -z "$PATH_DEP" ]]; then
      echo "spool add: need --git or --path" >&2
      exit 1
    fi
    export SPOOL_ADD_NAME="$NAME"
    export SPOOL_ADD_GIT="$GIT"
    export SPOOL_ADD_PATH="$PATH_DEP"
    export SPOOL_ADD_VERSION="$VERSION"
    check_engine
    run_coil add_manifest
    check_status
    check_engine
    run_project_script pre_install
    if [[ -n "$GIT" ]]; then
      resolve_git_dep "$NAME" "$GIT"
    fi
    walk_transitives
    materialize
    run_include_hooks
    run_project_script post_install
    echo "spool add: ok"
    ;;
  update)
    ONLY="${1:-}"
    check_engine
    run_coil list_git_deps
    check_status
    if [[ ! -s "$SPOOL_PROJECT/.spool/git-deps.tsv" ]]; then
      if [[ -n "$ONLY" ]]; then
        echo "spool update: \`$ONLY\` is not a git dependency" >&2
        exit 1
      fi
      echo "spool update: no git dependencies" >&2
      exit 1
    fi
    found=0
    while IFS=$'\t' read -r name url _version; do
      [[ -z "${name:-}" ]] && continue
      if [[ -n "$ONLY" && "$name" != "$ONLY" ]]; then
        continue
      fi
      found=1
    done < "$SPOOL_PROJECT/.spool/git-deps.tsv"
    if [[ -n "$ONLY" && "$found" -eq 0 ]]; then
      echo "spool update: \`$ONLY\` is not a git dependency" >&2
      exit 1
    fi
    run_project_script pre_update
    while IFS=$'\t' read -r name url _version; do
      [[ -z "${name:-}" ]] && continue
      if [[ -n "$ONLY" && "$name" != "$ONLY" ]]; then
        continue
      fi
      resolve_git_dep "$name" "$url"
    done < "$SPOOL_PROJECT/.spool/git-deps.tsv"
    walk_transitives
    materialize
    run_include_hooks
    run_project_script post_update
    echo "spool update: ok"
    ;;
  *)
    echo "unknown command: $CMD" >&2
    run_coil help
    exit 1
    ;;
esac
